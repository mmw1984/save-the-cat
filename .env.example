# Google OAuth client (Google Cloud console → Credentials → OAuth 2.0 Client ID, type "Web application")
# The client ID is public (it ships to the browser); the secret is not needed — GIS issues
# an ID token that the server verifies against Google's public keys.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Only accounts on this Google Workspace domain may sign
NEXT_PUBLIC_ALLOWED_DOMAIN=ccchwc.edu.hk

# Supabase — server-side only. The browser NEVER sees these: all DB access goes
# through route handlers with the service-role key, so the Supabase domain is
# not exposed to clients and cannot be DDoSed directly.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role key>

# Random 64-char hex used to sign session cookies (HMAC-SHA256)
SESSION_SECRET=<openssl rand -hex 32>
